{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "manim-agent",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "django-backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["backend/manage.py", "runserver", "--noreload", "8000"],
      "port": 8000
    },
    {
      "name": "graph-frontend",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "preview", "--port", "5175", "--strictPort"],
      "port": 5175,
      "env": { "VITE_API_BASE": "http://localhost:8000" }
    }
  ]
}
